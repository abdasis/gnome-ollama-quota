<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ollama-quota"
          path="/org/gnome/shell/extensions/ollama-quota/">
    <key name="api-key" type="s">
      <default>''</default>
      <summary>API key Ollama</summary>
      <description>Kunci API Ollama Cloud untuk membaca kuota dan pemakaian.</description>
    </key>
    <key name="refresh-interval" type="i">
      <default>5</default>
      <range min="1" max="60"/>
      <summary>Interval penyegaran</summary>
      <description>Jarak antar penyegaran otomatis dalam menit.</description>
    </key>
  </schema>
</schemalist>
